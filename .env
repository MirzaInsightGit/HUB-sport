# ===========================
# API Base URL
# ===========================

# Backend API bas-URL för lokal och prod
REACT_APP_API_BASE_LOCAL=http://localhost:8080/api
REACT_APP_API_BASE_PROD=https://stockholmbasket-express-api-avf6ayfkdnc3b6gn.centralus-01.azurewebsites.net/api

# Azure backend (avkommentera om du vill bygga mot den istället)
# REACT_APP_API_BASE=https://stockholmbasket-express-api-avf6ayfkdnc3b6gn.centralus-01.azurewebsites.net/api

# ===========================
# Profixio API-inställningar
# ===========================
REACT_APP_PROFIXIO_ORG=SBBF.SE.BB
REACT_APP_PROFIXIO_BASE_URL=https://www.profixio.com/app/api

# OBS! API-nyckeln för Profixio ska INTE ligga här i frontend
# Den ska bara finnas i backend .env

# ===========================
# WooCommerce (endast URL)
# ===========================
REACT_APP_WC_URL=https://stockholmbasket.se

# OBS! WooCommerce KEY/SECRET ska INTE ligga i frontend .env
# Dessa ligger i backend .env och används därifrån

# ===========================
# Bygg-inställningar
# ===========================
GENERATE_SOURCEMAP=false
# ===========================
# API Base URL (unified)
# ===========================
# Frontend will call /api in prod behind reverse proxy (recommended).
# In local dev, you can still run without proxy by temporarily setting REACT_APP_API_BASE to http://localhost:8080.
# The app code will read REACT_APP_API_BASE first. The *_LOCAL/_PROD values are kept only as references.
REACT_APP_API_BASE=/api

# Legacy/reference values (not used by the app if REACT_APP_API_BASE is set):
REACT_APP_API_BASE_LOCAL=http://localhost:8080/api
REACT_APP_API_BASE_PROD=https://stockholmbasket-express-api-avf6ayfkdnc3b6gn.centralus-01.azurewebsites.net/api
# REACT_APP_API_BASE=https://stockholmbasket-express-api-avf6ayfkdnc3b6gn.centralus-01.azurewebsites.net/api

# ===========================
# Profixio API-inställningar
# ===========================
REACT_APP_PROFIXIO_ORG=SBBF.SE.BB
REACT_APP_PROFIXIO_BASE_URL=https://www.profixio.com/app/api

# OBS! API-nyckeln för Profixio ska INTE ligga här i frontend
# Den ska bara finnas i backend .env

# ===========================
# WooCommerce (endast URL)
# ===========================
REACT_APP_WC_URL=https://stockholmbasket.se

# OBS! WooCommerce KEY/SECRET ska INTE ligga i frontend .env
# Dessa ligger i backend .env och används därifrån

# ===========================
# Bygg-inställningar
# ===========================
GENERATE_SOURCEMAP=false