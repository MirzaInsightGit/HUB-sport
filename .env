# ===========================
# Backend API bas-URL
# ===========================
# Frontend anropar alltid backend via Azure
REACT_APP_API_BASE=https://stockholmbasket-express-api-avf6ayfkdnc3b6gn.centralus-01.azurewebsites.net/api

# ===========================
# WooCommerce (endast URL – nycklar finns i backend)
# ===========================
REACT_APP_WC_URL=https://stockholmbasket.se

# ===========================
# Profixio API (endast för UI/visning – nyckel finns i backend)
# ===========================
REACT_APP_PROFIXIO_ORG=SBBF.SE.BB
REACT_APP_PROFIXIO_BASE_URL=https://www.profixio.com/app/api

# ===========================
# HUB-specifika värden
# ===========================
REACT_APP_DLT_BUDGET=250000
REACT_APP_DLT_CATEGORY_ID=dlt

# ===========================
# Auth / Debug
# ===========================
# Aktiverar /debug/claims route så du kan se roller & grupper
REACT_APP_AUTH_DIAG=true

# Välj auth-mode:
# - default        = accepterar både roles och groups
# - strict_groups  = kräver uttryckligt gruppmedlemskap
REACT_APP_AUTH_MODE=strict_groups

# Grupp-ID:n för respektive roll (Azure Entra ID grupper)
REACT_APP_COACH_GROUP_IDS=f824f296-d48c-4b56-bf17-3368ecb58dfa
REACT_APP_ADMIN_GROUP_IDS=0562f245-01fd-44da-b2d1-b90337e6b82d

# ===========================
# Build settings
# ===========================
GENERATE_SOURCEMAP=false

# === Dev proxy till backend på http://localhost:8080 ===
BACKEND_LOCAL=1