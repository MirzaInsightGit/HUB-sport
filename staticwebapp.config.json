{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "*.{png,jpg,svg,gif,ico,css,js}"]
  },
  "routes": [
    {
      "route": "/admin/*",
      "serve": "/index.html"
    },
    {
      "route": "/auth/*",
      "serve": "/index.html"
    }
  ],
  "platform": {
    "apiRuntime": "node:18"
  },
  "reverseProxy": {
    "/api/*": "https://stockholmbasket-express-api-avf6ayfkdnc3b6gn.centralus-01.azurewebsites.net"
  }
}