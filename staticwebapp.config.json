{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "*.{png,jpg,svg,gif,ico,css,js}"]
  },
  "routes": [
    {
      "route": "/admin/*",
      "serve": "/index.html"
    },
    {
      "route": "/auth/*",
      "serve": "/index.html"
    },
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"],
      "proxy": {
        "backendUri": "https://stockholmbasket-express-api-avf6ayfkdnc3b6gn.centralus-01.azurewebsites.net"
      }
    }
  ],
  "responseOverrides": {
    "401": {
      "rewrite": "/index.html"
    }
  }
}