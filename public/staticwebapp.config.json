{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/*.{png,jpg,svg,gif,ico,css,js}"]
  },
  "routes": [
    { "route": "/admin/*", "rewrite": "/index.html" },
    { "route": "/auth/*", "rewrite": "/index.html" },
    { "route": "/api/*", "statusCode": 404 }
  ],
  "responseOverrides": {
    "401": { "rewrite": "/index.html" }
  }
}